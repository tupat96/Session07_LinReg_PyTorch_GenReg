        "    for epoch in range(num_epochs):\n",
        "        model.train()\n",
        "        for xb, yb in dl:\n",
        "            opt.zero_grad()\n",
        "            loss = loss_fn(model(xb), yb)\n",
        "            loss.backward()\n",
