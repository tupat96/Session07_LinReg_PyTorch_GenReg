    "## put them in your working sets\n",
    "X_train, X_test = poly_features[:n_train], poly_features[n_train:]\n",
    "y_train, y_test = labels[:n_train], labels[n_train:]\n",
    "x_train_raw, x_test_raw = features[:n_train], features[n_train:]"
